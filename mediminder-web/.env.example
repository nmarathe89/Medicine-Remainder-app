# Copy to .env for local overrides. .env is git-ignored — never commit real secrets.
JWT_SECRET=local-dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Host port bindings. Leave commented for the defaults (3000, 8000). If any
# of those are taken on your machine, uncomment and pick free ones.
#FRONTEND_HOST_PORT=3001
#BACKEND_HOST_PORT=8001
