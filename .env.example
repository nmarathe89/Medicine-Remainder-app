# Copy to .env for local Docker Compose. DO NOT commit a real .env.
# All values here are safe placeholders for local development only.

# Postgres (local compose)
POSTGRES_USER=mediminder
POSTGRES_PASSWORD=mediminder
POSTGRES_DB=mediminder
# Host port for the DB (container port stays 5432). Change if 5433 is in use.
DB_HOST_PORT=5433

# Backend
# local: point at the compose "db" service. cloud: Cloud SQL connection string.
DATABASE_URL=postgresql+psycopg://mediminder:mediminder@db:5432/mediminder
# Change this for any non-local use. In cloud it is loaded from Secret Manager.
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
# local | cloud  — governs Secret Manager usage
APP_ENV=local

# Cloud-only (informational; not used locally):
# GCP_SECRET_RESOURCE=projects/645869155931/secrets/serviceaccount

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000
